{
  "name": "teacher-inquiry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "npm run check && next build",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx scripts/check.ts && node --import tsx scripts/stubs.ts",
    "drafts": "node --import tsx scripts/check.ts --drafts",
    "eval": "node --env-file=.env.local --import tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
